OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-me
OPENAI_DEFAULT_MODEL=gpt-5.6-sol

# Models
EXTRACTOR_MODEL=openai/gpt-5.6-luna
CRITIC_MODEL=openai/gpt-5.6-luna
FIXER_MODEL=openai/gpt-5.6-luna
WIKI_PLANNER_MODEL=openai/gpt-5.6-luna
WIKI_RELATION_MODEL=openai/gpt-5.6-luna
WIKI_PAGE_PLAN_MODEL=openai/gpt-5.6-luna
WIKI_CREATOR_MODEL=openai/gpt-5.6-luna
WIKI_REVIEWER_MODEL=openai/gpt-5.6-luna
WIKI_FINALIZER_MODEL=openai/gpt-5.6-luna

EMBEDDING_BASE_URL=https://localhost:8080/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_DEFAULT_MODEL=embeddinggemma-300m
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_INPUT_CHARS=1200

# Qdrant
QDRANT_PATH=.qdrant
# QDRANT_URL=https://qdrant.example.com
# QDRANT_API_KEY=replace-me
QDRANT_COLLECTION=wiki-concepts
QDRANT_WORK_PACKAGE_COLLECTION=wiki-work-packages

# Concept extraction
WIKI_NUM_CONCEPT_PAGES=3
WIKI_EXTRACTION_WORKERS=4
CONCEPT_MAX_TURNS=5

# Candidate planning
WIKI_PLANNING_BATCH_SIZE=5
WIKI_PLANNING_WORKERS=8
WIKI_SIMILAR_CONCEPTS_TOP_K=10

# Work-package relation resolution
WIKI_WORK_PACKAGE_TOP_K=20
WIKI_RELATION_BATCH_SIZE=24
WIKI_RELATION_WORKERS=8

# Graph ranking
WIKI_GRAPH_PAGERANK_ALPHA=0.85

# Wiki link ranking
WIKI_MAX_OUTGOING_LINKS=8
WIKI_LINK_ALWAYS_INCLUDE_SIMILARITY=0.92
WIKI_LINK_SEMANTIC_WEIGHT=0.50
WIKI_LINK_PERSONALIZED_PAGERANK_WEIGHT=0.35
WIKI_LINK_GLOBAL_PAGERANK_WEIGHT=0.15

# Page-definition aggregation
WIKI_PAGE_PLAN_WORKERS=8

# Page creation and independent review/correction
WIKI_PAGE_WORKERS=4
WIKI_PAGE_TRANSIENT_RETRIES=2
WIKI_MAX_TURNS=5
WIKI_FINALIZER_BATCH_SIZE=20
WIKI_FINALIZER_TIMEOUT_SECONDS=900

WIKI_GIT_AUTHOR_NAME=Wiki Agent
WIKI_GIT_AUTHOR_EMAIL=wiki-agent@localhost

WEAVE_PROJECT=wiki-agents
WEAVE_PRINT_CALL_LINK=false
WEAVE_LOG_LEVEL=WARNING
# Set this value to correlate separate commands as one pipeline run.
# WIKI_RUN_ID=
LOG_LEVEL=INFO
THIRD_PARTY_LOG_LEVEL=WARNING
